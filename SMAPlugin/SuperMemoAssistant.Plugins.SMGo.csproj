<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <UseWPF>true</UseWPF>
    <RootNamespace>SuperMemoAssistant.Plugins.SMGo</RootNamespace>
    <AssemblyName>SuperMemoAssistant.Plugins.SMGo</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- NuGet package metadata -->
    <PackageId>SuperMemoAssistant.Plugins.SMGo</PackageId>
    <Version>1.0.0</Version>
    <Authors>Deepak</Authors>
    <Description>Mobile companion bridge for SuperMemo</Description>
    <Product>SMGo</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SuperMemoAssistant.Interop" Version="2.1.0-beta.26" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- After build: copy DLL to SMA package store -->
  <Target Name="CopyOutput" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <Exec Command="copy /y &quot;$(TargetDir)$(AssemblyName).dll&quot; &quot;$(UserProfile)\SuperMemoAssistant\Plugins\Packages\$(AssemblyName).$(Version)\lib\net472\$(AssemblyName).dll&quot;" />
  </Target>
</Project>
